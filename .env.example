# Copy this file to `.env` and adjust the values.

# PostgreSQL connection string. The default matches docker-compose.yml.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"

# Public URL of the site, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Salt for hashing visitor IPs (rate limiting, analytics, endorsements).
# Use a long random string in production: `openssl rand -hex 32`
VISITOR_HASH_SALT="change-me-to-a-long-random-string"

# --- Email notifications (optional) -----------------------------------------
# Leave RESEND_API_KEY empty to mock emails: they are logged to the server
# console instead of being sent. Get a key at https://resend.com
RESEND_API_KEY=""
# Where contact-form notifications are delivered.
CONTACT_TO_EMAIL="i.yogisharma5@gmail.com"
# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
